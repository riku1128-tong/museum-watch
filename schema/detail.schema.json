{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "美術館の詳細（Claude が公式サイトから更新する）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "checked_at", "operating_status", "source_urls", "regular_hours",
               "closed_weekdays", "holiday_rule", "special_closures", "special_openings",
               "exhibitions", "confidence"],
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
    "weekday": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun", "holiday"]},
    "free_scope": {"enum": ["all", "collection", "partial"], "description": "all = 館全体（企画展も）無料、collection = 常設展・コレクション展のみ無料、partial = targets に挙げた展覧会・区域だけ無料"},
    "free_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "scope が partial のとき、無料になる展覧会名（の一部）や区域（例: 庭園）"},
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "open", "close"],
      "properties": {
        "days": {"type": "array", "items": {"$ref": "#/$defs/weekday"}, "minItems": 1},
        "open": {"$ref": "#/$defs/time"},
        "close": {"$ref": "#/$defs/time"},
        "last_entry": {"$ref": "#/$defs/time"},
        "from": {"$ref": "#/$defs/date", "description": "この時間が有効になる最初の日（季節ごとに時間が変わる場合）"},
        "to": {"$ref": "#/$defs/date"}
      }
    }
  },
  "properties": {
    "id": {"type": "string"},
    "checked_at": {"type": "string", "format": "date-time"},
    "check_mode": {"enum": ["full", "light"]},
    "operating_status": {
      "enum": ["operating", "temporarily_closed", "permanently_closed", "unknown"],
      "description": "temporarily_closed = 改修などで長期休館中。permanently_closed = 閉館済み"
    },
    "status_note": {"type": ["string", "null"]},
    "official_url": {"type": ["string", "null"], "description": "museums.json の公式URLが無い・誤っている場合に上書きする"},
    "address": {"type": ["string", "null"]},
    "source_urls": {"type": "array", "items": {"type": "string"}},
    "regular_hours": {"type": "array", "items": {"$ref": "#/$defs/hours"}},
    "closed_weekdays": {"type": "array", "items": {"$ref": "#/$defs/weekday"}},
    "closed_nth_weekdays": {
      "type": "array",
      "description": "第n週の曜日の定休日。例: 第1・第3月曜休館 → [{\"weekday\": \"mon\", \"nth\": [1, 3]}]。holiday_rule も同じように適用される",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["weekday", "nth"],
        "properties": {"weekday": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]},
                       "nth": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 5}, "minItems": 1}}
      }
    },
    "holiday_rule": {
      "enum": ["open", "open_next_weekday_closed", "closed", "unknown"],
      "description": "open = 祝日は休館曜日でも開館（振替休館なし）。open_next_weekday_closed = 祝日なら開館し翌平日に休館。closed = 祝日は休館"
    },
    "special_closures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to"],
        "properties": {"from": {"$ref": "#/$defs/date"}, "to": {"$ref": "#/$defs/date"},
                       "reason": {"type": ["string", "null"]}}
      }
    },
    "special_openings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["date"],
        "properties": {"date": {"$ref": "#/$defs/date"}, "open": {"$ref": "#/$defs/time"},
                       "close": {"$ref": "#/$defs/time"}, "note": {"type": ["string", "null"]}}
      }
    },
    "exhibitions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "start", "end"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "start": {"$ref": "#/$defs/date"},
          "end": {"$ref": "#/$defs/date"},
          "url": {"type": ["string", "null"]},
          "kind": {"enum": ["special", "collection", "other"]},
          "summary": {"type": ["string", "null"], "maxLength": 200},
          "admission": {"type": ["string", "null"]},
          "adult_price": {"type": ["integer", "null"], "minimum": 0, "description": "この展覧会の大人一般（円）。無料は 0"},
          "hours": {"type": "array", "items": {"$ref": "#/$defs/hours"},
                    "description": "展覧会独自の開館時間（館の通常時間と違う場合のみ）"},
          "closed_weekdays": {"type": "array", "items": {"$ref": "#/$defs/weekday"},
                              "description": "展覧会独自の休館曜日（館と違う場合のみ）"},
          "closed_dates": {"type": "array", "items": {"$ref": "#/$defs/date"}}
        }
      }
    },
    "adult_price": {"type": ["integer", "null"], "minimum": 0,
                    "description": "館の入館料（常設展・コレクション展）の大人一般の料金（円）。無料は 0、常設展が無い館は null"},
    "free_days": {
      "type": "array",
      "description": "大人一般が無料になる日（日付が決まっているもの）。例: 都民の日 10/1、国際博物館の日 5/18",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "scope"],
        "properties": {"from": {"$ref": "#/$defs/date"}, "to": {"$ref": "#/$defs/date"},
                       "scope": {"$ref": "#/$defs/free_scope"}, "targets": {"$ref": "#/$defs/free_targets"},
                       "reason": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"]}}
      }
    },
    "free_rules": {
      "type": "array",
      "description": "毎月・毎週の無料日の規則。例: 毎月第1日曜は常設展無料 → {weekday: sun, nth: [1], scope: collection}",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["scope"],
        "properties": {"weekday": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]},
                       "nth": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 5}},
                       "day_of_month": {"type": "integer", "minimum": 1, "maximum": 31},
                       "scope": {"$ref": "#/$defs/free_scope"}, "targets": {"$ref": "#/$defs/free_targets"},
                       "reason": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"]}}
      }
    },
    "access": {
      "type": "array",
      "description": "最寄駅（近い順に最大 3 つ）",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["station"],
        "properties": {"station": {"type": "string", "description": "駅名（「駅」は付けない）"},
                       "lines": {"type": ["string", "null"], "description": "例: JR山手線・京浜東北線"},
                       "exit": {"type": ["string", "null"]},
                       "walk_min": {"type": ["integer", "null"], "minimum": 0},
                       "note": {"type": ["string", "null"], "description": "バス利用など徒歩以外の行き方"}}
      }
    },
    "closed_between_exhibitions": {"type": "boolean", "description": "展示替え期間（開催中の展示が無い日）は休館する館か"},
    "notes": {"type": ["string", "null"]},
    "confidence": {"enum": ["high", "medium", "low"]}
  }
}
